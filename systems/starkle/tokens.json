      "#5D6BE0",
      "#F4776A",
      "#2FB5AB",
      "#9C6BDD"
    ],
    "blocker": {
      "top": "#ffffff",
      "side": "#d6d6da",
      "rim": "#e3e3e7"
    },
    "piece-render": {
      "shadow": "union silhouette, blur sigma 0.12, offset 0.16, 22% ink",
      "side": "piece colour at 72% luminance, offset 0.13",
      "groove": "internal edges at 82% luminance, width 0.07, round caps",
      "rim": "outer edge at 90% luminance, width 0.05"
    }
  },
  "deltas": [
    "gold is game state, never a control",
    "icon circles 44px not 40",
    "no filled button while a board is in play",
    "countdown before the server clock starts; the clock shows a hint's penalty at once",
    "--ink3 never for text under 24px (2.31:1)",
    "one fact once per screen",
    "every phone 360x740 to 430x932; play screens fit one viewport",
    "explainers live in How to play; no coach marks on game screens",
    "thumbs and switches slide by WAAPI, not CSS transitions"
  ],
  "source": "builtbylee/starkle web/src/styles.css (shipped 2026-09-24)",
  "size": {
    "target-min": "44px",
