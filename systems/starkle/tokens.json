  "color": {
    "bg": "#efeff1",
    "sheet": "#fff",
    "sunk": "#f5f5f7",
    "sunk2": "#ebebee",
    "ink": "#111114",
    "ink2": "#62656b",
    "ink3": "#9c9fa6",
    "hair": "#e9e9ec",
    "live": "#2eb87f",
    "warn-ink": "#8a2f22",
    "warn-bg": "#fbecea",
    "gold": "#E9B93A"
  },
  "radius": {
    "lg": "30px",
    "md": "22px",
    "sm": "14px",
    "pill": "999px"
  },
  "shadow": {
    "sh1": "0 1px 2px rgba(17,17,20,.04), 0 3px 10px -5px rgba(17,17,20,.08)",
