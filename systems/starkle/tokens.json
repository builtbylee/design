      "coral": "#F4776A",
      "tangerine": "#F59A3E",
      "jade": "#3E9C63",
      "teal": "#2FB5AB",
      "sky": "#4FA3E3",
      "indigo": "#5D6BE0",
      "violet": "#9C6BDD",
      "rose": "#E877B0",
      "cocoa": "#A6714E",
      "strip": "#F0C33C"
