    "google": "https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=DM+Mono:wght@300;400;500&display=swap"
  },
  "motion": {
    "ease": "cubic-bezier(.22,1,.36,1)",
