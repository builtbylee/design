{
  "$schema": "../../templates/tokens.schema.json",
  "name": "Dossier",
  "version": "1",
  "source": "builtbylee/leesam index.html (inline <style> lines 18-425; scripts for motion)",
  "color": {
    "navy": "#0a2540",
    "ink": "#0f2540",
    "muted": "#4a5a6d",
    "blue": "#2563eb",
    "blue-deep": "#1d4ed8",
    "blue-soft": "#e8efff",
    "bar": "#b9cdf7",
    "line": "#e3e8ef",
    "paper": "#f5f8fb",
    "white": "#ffffff",
    "spine": "#cfd8e3",
    "rim": "#c9d3e0",
    "faint": "#9aa8b8",
    "on-navy": "#b9c6d8",
    "sky": "#8fb0ff"
  },
  "radius": {
    "xl": "20px",
    "lg": "14px",
    "md": "10px",
    "sm": "8px",
    "pill": "999px"
  },
  "shadow": {
    "object": "0 32px 70px -50px rgba(10,37,64,.35)",
    "inset-object": "0 24px 50px -40px rgba(10,37,64,.45)"
  },
  "font": {
    "ui": "\"Instrument Sans\",system-ui,-apple-system,\"Segoe UI\",sans-serif",
    "display": "\"Instrument Serif\",Georgia,serif",
    "google": "https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
  },
  "motion": {
    "ease": "cubic-bezier(.32,.72,0,1)",
    "grow": "cubic-bezier(.22,1,.36,1)",
    "hover": "160ms",
    "indicator": "380ms",
    "panel": "420ms",
    "carousel": "600ms",
    "count": "1400ms"
  },
  "size": {
    "shell": "1180px",
    "gutter": "24px",
    "gutter-phone": "16px",
    "topbar": "68px",
    "target": "44px",
    "section-pad": "88px",
    "section-pad-phone": "64px"
  },
  "deltas": [
    "blue-deep #1d4ed8 for blue text on blue-soft (source --blue measures 4.48:1)",
    "faint #9aa8b8 is never text (source step numbers measure 2.42:1)",
    "all touch targets min 44px (source: cta 38px, step chip 32px, segment 36px, dot 8px)"
  ]
}
